# ====================================================================
# Environment variables template for E-Commerce Microservices
# ====================================================================
# Copy this file to ".env" and fill in real values:
#   cp .env.example .env
# Then start services via: .\start_with_env.ps1
# DO NOT commit .env to Git (already in .gitignore)
# ====================================================================

# ---- JWT ----
# Used by api-gateway and user-service to sign/validate JWT tokens.
# Must be at least 32 chars for HS256. Generate via:
#   [System.Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long

# ---- Kafka (Aiven Cloud) ----
KAFKA_BOOTSTRAP_SERVERS=kafka-hiepweb2-nguyenvuhiep401-b7ce.h.aivencloud.com:19105
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=replace-with-real-aiven-password
KAFKA_TRUSTSTORE_PASSWORD=replace-with-truststore-password

# ---- MySQL ----
# Used by 4 services: user, product-catalog, product-recommendation, order
# IMPORTANT: must match the password set on the MySQL 'ecom_app' user (H2)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=ecom_app
MYSQL_PASSWORD=change-me-strong-password

# ---- OpenRouter AI Chatbot ----
# Used by the React frontend chatbot (Vite requires VITE_ prefix)
# Get your key at: https://openrouter.ai/settings/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
VITE_OPENROUTER_MODEL=google/gemma-4-31b-it:free
